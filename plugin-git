#!/usr/bin/env python3
"""Report and change the git state of the OmarKEYS plugin checkout.

Backs the branch picker in the overlay's bottom corner: which branch is
loaded, which branches you could switch to, and whether the branch you
are on has newer commits waiting on the remote.

Every subcommand prints one JSON object on stdout. Mutating commands are
deliberately conservative: they refuse rather than discard work, never
force, and never reset --hard, because this runs against a live checkout
that a person (or another agent) may be working in.

  status            current branch/hash/dirty + selectable branches
  fetch             refresh remote refs first, then report status
  switch <branch>   checkout a branch, then fast-forward it to the remote
  sync              fast-forward the current branch to its upstream
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent
FETCH_TIMEOUT = 20
GIT_TIMEOUT = 30


def git(*args: str, timeout: int = GIT_TIMEOUT) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", str(REPO), *args],
        check=False,
        text=True,
        capture_output=True,
        timeout=timeout,
    )


def out(value: str) -> str:
    return (value or "").strip()


def git_error(proc: subprocess.CompletedProcess) -> str:
    """First meaningful line of git's complaint, for the overlay to show."""
    text = out(proc.stderr) or out(proc.stdout) or "git failed"
    for line in text.splitlines():
        line = line.strip()
        if line and not line.startswith("hint:"):
            return line
    return text.splitlines()[0] if text.splitlines() else "git failed"


def current_branch() -> str:
    proc = git("rev-parse", "--abbrev-ref", "HEAD")
    return out(proc.stdout) if proc.returncode == 0 else ""


def selectable_branches() -> list[str]:
    """Local branches plus origin branches that have no local counterpart."""
    names: list[str] = []
    local = git("for-each-ref", "--format=%(refname)", "refs/heads")
    if local.returncode == 0:
        names = [
            ref[len("refs/heads/"):]
            for ref in out(local.stdout).splitlines()
            if ref.startswith("refs/heads/")
        ]
    seen = set(names)
    remote = git("for-each-ref", "--format=%(refname)", "refs/remotes/origin")
    if remote.returncode == 0:
        prefix = "refs/remotes/origin/"
        for ref in out(remote.stdout).splitlines():
            if not ref.startswith(prefix):
                continue
            name = ref[len(prefix):]
            # refs/remotes/origin/HEAD is a symbolic pointer, not a branch.
            if not name or name == "HEAD" or name in seen:
                continue
            names.append(name)
            seen.add(name)
    # A branch checked out in another worktree cannot be switched to here,
    # so offering it would only produce a git error on click.
    held = checked_out_elsewhere() - {current_branch()}
    return sorted(n for n in names if n not in held)


def checked_out_elsewhere() -> set[str]:
    """Branches held by another worktree, which git will not let us switch to."""
    held: set[str] = set()
    proc = git("worktree", "list", "--porcelain")
    if proc.returncode != 0:
        return held
    this_repo = str(REPO)
    path = ""
    for line in out(proc.stdout).splitlines():
        if line.startswith("worktree "):
            path = line[len("worktree "):].strip()
        elif line.startswith("branch "):
            ref = line[len("branch "):].strip()
            name = ref.split("refs/heads/", 1)[-1]
            if path and path != this_repo:
                held.add(name)
    return held


def upstream_ref(branch: str) -> str:
    """The branch's upstream, falling back to origin/<branch>.

    A local branch is not always created with tracking info - `git branch`
    without --track, or a checkout made by hand - and without this the
    branch would silently report 0 behind and refuse to auto-sync.
    """
    up = git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
    if up.returncode == 0 and out(up.stdout):
        return out(up.stdout)
    if branch:
        remote = git("rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{branch}")
        if remote.returncode == 0:
            return f"origin/{branch}"
    return ""


def divergence(branch: str) -> tuple[str, int, int]:
    """(upstream, ahead, behind) for branch, or ("", 0, 0) with no upstream."""
    upstream = upstream_ref(branch)
    if not upstream:
        return "", 0, 0
    counts = git("rev-list", "--left-right", "--count", f"{upstream}...HEAD")
    if counts.returncode != 0:
        return upstream, 0, 0
    parts = out(counts.stdout).split()
    if len(parts) != 2:
        return upstream, 0, 0
    behind, ahead = int(parts[0]), int(parts[1])
    return upstream, ahead, behind


def status_payload(error: str = "") -> dict:
    branch = current_branch()
    hash_proc = git("rev-parse", "--short", "HEAD")
    dirty_proc = git("status", "--porcelain")
    upstream, ahead, behind = divergence(branch)
    return {
        "ok": not error,
        "error": error,
        "branch": branch,
        "hash": out(hash_proc.stdout) if hash_proc.returncode == 0 else "",
        "dirty": bool(out(dirty_proc.stdout)) if dirty_proc.returncode == 0 else False,
        "upstream": upstream,
        "ahead": ahead,
        "behind": behind,
        "updateAvailable": behind > 0,
        "branches": selectable_branches(),
    }


def cmd_status(_args: argparse.Namespace) -> dict:
    return status_payload()


def cmd_fetch(_args: argparse.Namespace) -> dict:
    error = ""
    try:
        proc = git("fetch", "--quiet", "origin", timeout=FETCH_TIMEOUT)
        if proc.returncode != 0:
            error = git_error(proc)
    except subprocess.TimeoutExpired:
        error = "fetch timed out"
    payload = status_payload()
    # A failed fetch still reports usable local state; say so without
    # pretending the remote comparison is fresh.
    payload["fetchError"] = error
    return payload


def cmd_switch(args: argparse.Namespace) -> dict:
    branch = (args.branch or "").strip()
    if not branch:
        return status_payload("no branch given")
    if branch == current_branch():
        return status_payload()
    dirty = git("status", "--porcelain")
    if out(dirty.stdout):
        return status_payload("uncommitted changes - not switching")
    local = git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}")
    if local.returncode == 0:
        proc = git("checkout", branch)
    else:
        remote = git("rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{branch}")
        if remote.returncode != 0:
            # A branch created since this checkout last fetched (a fresh
            # release channel, say) is not "unknown" - just unseen.
            try:
                git("fetch", "--quiet", "origin", timeout=FETCH_TIMEOUT)
            except subprocess.TimeoutExpired:
                return status_payload("fetch timed out")
            remote = git("rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{branch}")
        if remote.returncode != 0:
            return status_payload(f"unknown branch {branch}")
        proc = git("checkout", "-b", branch, "--track", f"origin/{branch}")
    if proc.returncode != 0:
        return status_payload(git_error(proc))
    # Land on the newest commit of the branch, not whatever local tip was
    # left behind the last time this channel was visited. Reported as a
    # soft failure: the switch itself already happened, so a fetch that
    # cannot reach the network should not read as "switch failed".
    # Sync first, then report: building the payload before the
    # fast-forward would hand the overlay the pre-sync hash and a stale
    # "behind" count for a branch it had just brought up to date.
    sync_error = fast_forward()
    payload = status_payload()
    payload["syncError"] = sync_error
    return payload


def fast_forward() -> str:
    """Bring the current branch up to its upstream. Returns "" or an error."""
    try:
        fetched = git("fetch", "--quiet", "origin", timeout=FETCH_TIMEOUT)
    except subprocess.TimeoutExpired:
        return "fetch timed out"
    if fetched.returncode != 0:
        return git_error(fetched)
    upstream = upstream_ref(current_branch())
    if not upstream:
        return "no upstream to sync from"
    # --ff-only so a diverged branch reports instead of creating a merge.
    proc = git("merge", "--ff-only", upstream)
    if proc.returncode != 0:
        return git_error(proc)
    return ""


def cmd_sync(_args: argparse.Namespace) -> dict:
    dirty = git("status", "--porcelain")
    if out(dirty.stdout):
        return status_payload("uncommitted changes - not syncing")
    return status_payload(fast_forward())


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("status").set_defaults(func=cmd_status)
    sub.add_parser("fetch").set_defaults(func=cmd_fetch)
    switch = sub.add_parser("switch")
    switch.add_argument("branch")
    switch.set_defaults(func=cmd_switch)
    sub.add_parser("sync").set_defaults(func=cmd_sync)
    args = parser.parse_args()
    if not getattr(args, "func", None):
        args.func = cmd_status
    try:
        payload = args.func(args)
    except Exception as exc:  # never hand the overlay a non-JSON crash
        payload = {"ok": False, "error": str(exc), "branch": "", "hash": "",
                   "dirty": False, "upstream": "", "ahead": 0, "behind": 0,
                   "updateAvailable": False, "branches": []}
    json.dump(payload, sys.stdout)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
